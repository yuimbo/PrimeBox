+/*
+ * Asynchronous pan (Prime GO). rockchipdrmfb's FBIOPAN_DISPLAY blocks until
+ * the page flip lands (~one refresh), which serialised render + rotate + flip
+ * to ~30 fps. A dedicated thread performs the pan so the next frame renders
+ * meanwhile. With three fb buffers the one being rotated into is never the
+ * one on screen nor the one queued: rot_pan_claim() waits for that.
+ */
+static pthread_mutex_t rot_pan_lock = PTHREAD_MUTEX_INITIALIZER;
+static pthread_cond_t  rot_pan_cond = PTHREAD_COND_INITIALIZER;
+static int             rot_pan_shown   = -1;
+static int             rot_pan_pending = -1;
+static int             rot_pan_x, rot_pan_y;
+static bool            rot_pan_started;
+
+static void *
+rot_pan_thread( void *arg )
+{
+     (void) arg;
+
+     pthread_mutex_lock( &rot_pan_lock );
+     for (;;) {
+          int idx, x, y;
+
+          while (rot_pan_pending < 0)
+               pthread_cond_wait( &rot_pan_cond, &rot_pan_lock );
+
+          idx = rot_pan_pending;
+          x   = rot_pan_x;
+          y   = rot_pan_y;
+          pthread_mutex_unlock( &rot_pan_lock );
+
+          dfb_fbdev_pan( x, y, false );
+
+          pthread_mutex_lock( &rot_pan_lock );
+          rot_pan_shown   = idx;
+          rot_pan_pending = -1;
+          pthread_cond_broadcast( &rot_pan_cond );
+     }
+     return NULL;
+}
+
+/* wait until fb buffer idx is neither on screen nor queued for display */
+static void
+rot_pan_claim( int idx )
+{
+     pthread_mutex_lock( &rot_pan_lock );
+     while (idx == rot_pan_shown || idx == rot_pan_pending)
+          pthread_cond_wait( &rot_pan_cond, &rot_pan_lock );
+     pthread_mutex_unlock( &rot_pan_lock );
+}
+
+/* queue fb buffer idx for display; returns false if no pan thread exists */
+static bool
+rot_pan_queue( int idx, int x, int y )
+{
+     pthread_mutex_lock( &rot_pan_lock );
+     if (!rot_pan_started) {
+          pthread_t t;
+          rot_pan_started = pthread_create( &t, NULL, rot_pan_thread, NULL ) == 0;
+          if (rot_pan_started)
+               pthread_detach( t );
+     }
+     if (rot_pan_started) {
+          while (rot_pan_pending >= 0)
+               pthread_cond_wait( &rot_pan_cond, &rot_pan_lock );
+          rot_pan_pending = idx;
+          rot_pan_x       = x;
+          rot_pan_y       = y;
+          pthread_cond_broadcast( &rot_pan_cond );
+     }
+     pthread_mutex_unlock( &rot_pan_lock );
+     return rot_pan_started;
+}
