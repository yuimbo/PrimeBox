+static inline unsigned int
+rgb565_to_rgb32( unsigned int px )
+{
+     unsigned int r = (px >> 11) & 0x1f;
+     unsigned int g = (px >> 5)  & 0x3f;
+     unsigned int b = px & 0x1f;
+     r = (r << 3) | (r >> 2);
+     g = (g << 2) | (g >> 4);
+     b = (b << 3) | (b >> 2);
+     return 0xff000000 | (r << 16) | (g << 8) | b;
+}
+
+#define ROT_TILE 32
+
+static void
+rotate_tile( const unsigned char *src, int spitch, int src_bpp,
+             unsigned char *dst, int fpitch, int sw, int sh, int fw, int deg,
+             int tx, int xe, int ty, int ye )
+{
+     int x, y;
+
+     for (x = tx; x < xe; x++) {
+          unsigned int *d;
+          int           step;
+
+          switch (deg) {
+          case 90:
+               d = (unsigned int *)(dst + (sw - 1 - x) * fpitch) + ty;
+               step = 1;
+               break;
+          case 270:
+               d = (unsigned int *)(dst + x * fpitch) + (fw - 1 - ty);
+               step = -1;
+               break;
+          default:
+               d = (unsigned int *)(dst + (sh - 1 - ty) * fpitch) + (sw - 1 - x);
+               step = -(fpitch / 4);
+               break;
+          }
+
+          if (src_bpp == 2) {
+               const unsigned char *s = src + ty * spitch + x * 2;
+               for (y = ty; y < ye; y++, s += spitch, d += step)
+                    *d = rgb565_to_rgb32( *(const unsigned short *)s );
+          }
+          else {
+               const unsigned char *s = src + ty * spitch + x * 4;
+               for (y = ty; y < ye; y++, s += spitch, d += step)
+                    *d = *(const unsigned int *)s;
+          }
+     }
+}
+
+/* true if the tile differs from shadow; the shadow is refreshed to match.
+ * Rows are word-compared (tile rows are 4-byte aligned: ROT_TILE*bpp). */
+static bool
+tile_changed( const unsigned char *src, unsigned char *shadow, int spitch,
+              int bpp, int tx, int xe, int ty, int ye )
+{
+     size_t off   = (size_t)ty * spitch + tx * bpp;
+     int    words = (xe - tx) * bpp / 4;
+     bool   changed = false;
+     int    y, i;
+
+     for (y = ty; y < ye; y++, off += spitch) {
+          const unsigned int *a = (const unsigned int *)(src + off);
+          unsigned int       *b = (unsigned int *)(shadow + off);
+          for (i = 0; i < words; i++) {
+               if (a[i] != b[i]) {
+                    for (; i < words; i++)
+                         b[i] = a[i];
+                    changed = true;
+                    break;
+               }
+          }
+     }
+     return changed;
+}
+
+/*
+ * Rotate the logical layer frame (sw x sh, src_bpp 2 or 4) into the physical
+ * 32 bpp framebuffer (fw x fh), in ROT_TILE x ROT_TILE tiles so the strided
+ * side stays in L1. When shadow is given it holds the source frame last
+ * rotated into this fb buffer; tiles equal to it are skipped.
+ *
+ *   90  (left):  dst(row = sw-1-x, col = y)
+ *   270 (right): dst(row = x,      col = fw-1-y)
+ *   180:         dst(row = sh-1-y, col = sw-1-x)
+ *   other:       unrotated copy
+ */
+static void
+fbdev_rotate_primary( const unsigned char *src, int sw, int sh, int spitch,
+                      unsigned char *dst, int fw, int fh, int fpitch,
+                      int deg, int src_bpp, unsigned char *shadow )
+{
+     int tx, ty;
+
+     if (!src || !dst)
+          return;
+
+     if (deg != 90 && deg != 270 && deg != 180) {
+          int x, y;
+          for (y = 0; y < sh; y++) {
+               const unsigned char *s = src + y * spitch;
+               unsigned int        *d = (unsigned int *)(dst + y * fpitch);
+               if (src_bpp == 4)
+                    memcpy( d, s, (size_t)sw * 4 );
+               else
+                    for (x = 0; x < sw; x++)
+                         d[x] = rgb565_to_rgb32( ((const unsigned short *)s)[x] );
+          }
+          return;
+     }
+
+     for (ty = 0; ty < sh; ty += ROT_TILE) {
+          int ye = ty + ROT_TILE < sh ? ty + ROT_TILE : sh;
+          for (tx = 0; tx < sw; tx += ROT_TILE) {
+               int xe = tx + ROT_TILE < sw ? tx + ROT_TILE : sw;
+               if (shadow && !tile_changed( src, shadow, spitch, src_bpp, tx, xe, ty, ye ))
+                    continue;
+               rotate_tile( src, spitch, src_bpp, dst, fpitch, sw, sh, fw, deg, tx, xe, ty, ye );
+          }
+     }
+}
